rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['sunfall80@gmail.com', 'songman3374@gmail.com'];
    }

    // 문의: 웹 폼은 Cloud Function(admin SDK)으로만 생성, 관리자만 조회·수정·수동 등록·삭제
    match /inquiries/{doc} {
      allow read, create, update, delete: if isAdmin();
    }

    // Catch-all: deny everything else (otps, verified_phones, settings 포함)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
