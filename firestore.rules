rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /inquiries/{doc} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // OTP collections - only accessible from Cloud Functions (admin SDK)
    match /otps/{doc} {
      allow read, write: if false;
    }
    match /verified_phones/{doc} {
      allow read, write: if false;
    }
  }
}
